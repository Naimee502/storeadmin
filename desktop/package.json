{
  "name": "rudra-admin-desktop",
  "version": "1.0.0",
  "private": true,
  "description": "Desktop shell for the Rudra admin panel — adds OS-level screen-capture protection that a browser tab cannot provide.",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dev": "cross-env ADMIN_URL=http://localhost:5173 electron .",
    "build:win": "electron-builder --win",
    "build:mac": "electron-builder --mac"
  },
  "devDependencies": {
    "cross-env": "^7.0.3",
    "electron": "^32.0.0",
    "electron-builder": "^25.0.0"
  },
  "build": {
    "appId": "com.digisysindiatech.rudra.admin",
    "productName": "Rudra Admin",
    "files": [
      "main.js",
      "preload.js"
    ],
    "win": {
      "target": [
        "nsis"
      ]
    },
    "mac": {
      "target": [
        "dmg"
      ]
    }
  }
}
