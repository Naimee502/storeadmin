# Local development environment.
# Values mirror server/ecosystem.config.js (the pm2/production config) so tokens
# issued locally stay compatible; only NODE_ENV and the public base URL differ.
MONGO_URI=mongodb://127.0.0.1:27017/pos_billing_erp
PORT=4000
NODE_ENV=development

JWT_ACCESS_SECRET=your_super_secret_access_key_123
JWT_REFRESH_SECRET=your_super_secret_refresh_key_456

# Used by the uploadImage resolver to build image URLs the app can reach.
# The device hits localhost:4000 through `adb reverse tcp:4000 tcp:4000`.
PUBLIC_BASE_URL_DEV=http://localhost:4000

# Registration OTP email (Hostinger mailbox) — see src/utils/mail/index.ts.
# Put the mailbox password in SMTP_PASS. While it is empty no mail is sent and
# the OTP is only printed in this server's console.
SMTP_HOST=smtp.hostinger.com
SMTP_PORT=465
SMTP_USER=info@digisysindiatech.com
SMTP_PASS=NTindiatech@502
MAIL_FROM="Rudra ERP <info@digisysindiatech.com>"
